#!/usr/bin/with-contenv bash
# 微信连接器：配置和密钥都在就等微信起来再启动；缺一个就先开首次配置页（状态页上扫码登录、填 AstrBot 地址和口令），
# 两份都有了它自己退出，s6 重新拉起来时就是正常模式。挂了会被 s6 重新拉起
CONF=/config/wechat-connector/config.json
KEYS=/config/wechat-connector/keys.json
if [ ! -f "$CONF" ] || [ ! -f "$KEYS" ]; then
  echo "[wechat-connector] 还没有 config.json 或 keys.json，先开首次配置页：https://localhost:3001/wxc/"
  exec s6-setuidgid abc /lsiopy/bin/python3 -u /opt/wechat-connector/bridge.py setup --config "$CONF"
fi
until pgrep -x wechat >/dev/null; do
  sleep 2
done
sleep 5  # 等微信主窗口和无障碍桥起来
cd /config/wechat-connector
exec s6-setuidgid abc /lsiopy/bin/python3 -u /opt/wechat-connector/bridge.py run --config "$CONF"
